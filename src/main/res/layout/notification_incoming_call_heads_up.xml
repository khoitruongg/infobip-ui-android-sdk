<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="@drawable/bg_notification_incoming_call"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/notification_caller_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/notification_decline_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/incoming_call_action_decline"
        android:src="@drawable/ic_notification_decline" />

    <ImageView
        android:id="@+id/notification_accept_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/incoming_call_action_accept"
        android:src="@drawable/ic_notification_accept" />
</LinearLayout>
